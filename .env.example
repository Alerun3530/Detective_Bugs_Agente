OPENAI_API_KEY=sk-...
SUPABASE_URL=https://tuproyecto.supabase.co
SUPABASE_KEY=sb_secret_...

# El modelo que usa OpenCode. Si es un modelo de Anthropic, además
# necesitás ANTHROPIC_API_KEY=sk-ant-... acá abajo. Si es de OpenCode Go,
# necesitás OPENCODE_API_KEY=... en su lugar. OpenCode detecta la key
# sola según cuál esté seteada, sin login interactivo.
AGENTE_MODELO=anthropic/claude-sonnet-4-6
ANTHROPIC_API_KEY=sk-ant-...
# OPENCODE_API_KEY=...

# URL de git CON el token de GitHub embebido (Settings > Developer
# settings > Personal access tokens, permiso "repo"):
# https://TU_TOKEN@github.com/tu-usuario/repo-victima.git
GITHUB_REPO_URL=https://ghp_xxx@github.com/tu-usuario/repo-victima.git

# Secreto compartido con n8n (header X-Agent-Token).
# Generalo con: python -c "import secrets; print(secrets.token_hex(24))"
AGENT_TOKEN=cambiame

# Opcional: horas antes de reprocesar el mismo endpoint. Default 2.
VENTANA_DEDUP_HORAS=2

# NO hace falta setear REPO_PATH ni PORT — Railway los maneja solo
# (REPO_PATH usa el default /app/repo-victima-clone, PORT lo inyecta Railway).
