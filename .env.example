OPENAI_API_KEY=sk-.
SUPABASE_URL=https://tuproyecto.supabase.co
SUPABASE_KEY=sb_secret_...

# Carpeta LOCAL (en esta máquina) donde vive repo-victima — la MISMA que
# corre "npm run dev". El agente edita esos archivos directo.
REPO_PATH=C:/Users/aleco/proyectos/repo-victima

# Token que n8n tiene que mandar en el header X-Agent-Token. Generalo
# vos mismo, cualquier string largo random sirve. Sin esto, cualquiera
# que encuentre la URL del túnel de Cloudflare podría llamar al agente.
AGENT_TOKEN=cambiame-por-algo-largo-y-random

# Horas que hay que esperar antes de volver a procesar el mismo endpoint
# (evita que el monitor de anomalías, que repite cada 5 min, dispare al
# agente una y otra vez sobre el mismo caso).
VENTANA_DEDUP_HORAS=2

# Opcional: modelo del agente. Por default anthropic/claude-sonnet-4-6
AGENTE_MODELO=anthropic/claude-sonnet-4-6
