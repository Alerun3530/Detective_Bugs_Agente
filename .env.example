OPENAI_API_KEY=sk-...
SUPABASE_URL=https://tuproyecto.supabase.co
SUPABASE_KEY=sb_secret_...

# Carpeta LOCAL (en esta máquina) donde está el clone de git de
# repo-victima, conectado a GitHub, con el remote configurado para que
# git push funcione. El agente edita acá y pushea desde acá.
REPO_PATH=C:/ruta/a/repo-victima-clone

# Opcional: cambiar el modelo que usa el agente de código.
# Por default usa opencode-go/deepseek-v4-flash
AGENTE_MODELO=opencode-go/deepseek-v4-flash

# Secreto compartido con n8n. El nodo HTTP Request manda el header
# X-Agent-Token con este valor; sin él, /procesar responde 401.
# Generalo con: python -c "import secrets; print(secrets.token_hex(32))"
AGENT_TOKEN=cambiame

# Opcional: horas durante las que NO se vuelve a llamar al agente por el
# mismo endpoint (el monitor de anomalías repite cada 5 min). Default 2.
VENTANA_DEDUP_HORAS=2
